# Vercel Environment Variables — set di Vercel Dashboard > Settings > Environment Variables
# Jika diisi, /api/ai proxy akan pakai key server (client tidak perlu input key)

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
GEMINI_API_KEY=AIza...

# Groq (cepat & murah, recommended untuk free tier)
GROQ_API_KEY=gsk_...

# OpenRouter (akses banyak model dengan 1 key)
OPENROUTER_API_KEY=sk-or-...

# DeepSeek
DEEPSEEK_API_KEY=sk-...

# Mistral
MISTRAL_API_KEY=...

# Custom OpenAI Compatible
CUSTOM_AI_API_KEY=...
CUSTOM_AI_BASE_URL=https://api.example.com/v1

# Optional: enable proxy mode
AI_PROXY_ENABLED=true
